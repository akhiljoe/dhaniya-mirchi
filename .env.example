# Copy to .env (gitignored) and fill in. Read by docker compose.
# Generate secrets with a command, never by typing them in an editor — a value
# saved on Windows can carry an invisible \r that breaks it silently:
#   openssl rand -base64 32 | tr -d '\n'

# ---- Database ----
POSTGRES_PASSWORD=
POSTGRES_DB=dhaniya
POSTGRES_USER=dhaniya
# Loopback port for psql and the integration tests.
POSTGRES_HOST_PORT=5435

# ---- The site ----
# http://localhost:<WEB_PORT> is the app. It must match AUTH_REDIRECT_URI.
WEB_PORT=8100
NODE_ENV=development
LOG_LEVEL=info
WORKER_MEM_LIMIT=1g

# ---- Sign-in: Cognito (the shared Cognito pool) + Google (design §14.3) ----
# Off until the dhaniya-mirchi app client exists; /auth then answers 503.
AUTH_ENABLED=false
# The POOL (issuer + JWKS) — cognito-idp host, https, never the hosted domain.
AUTH_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/<pool-id>
AUTH_JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/<pool-id>/.well-known/jwks.json
# The HOSTED DOMAIN (login UI) — a different host from the issuer.
AUTH_AUTHORIZE_URL=https://auth.example.com/oauth2/authorize
AUTH_TOKEN_URL=https://auth.example.com/oauth2/token
# The dhaniya-mirchi app client: confidential (has a secret), Google ticked.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# The origin the BROWSER sees (nginx on WEB_PORT), never the api's own address.
# Comma-separated, one per address the site is opened on; a sign-in returns to
# the one matching its address. https, or http only on localhost (Cognito's
# rule). Each must also be an allowed callback URL on the Cognito app client.
# e.g. http://localhost:8100/auth/callback,https://app.dev.example.com/auth/callback
AUTH_REDIRECT_URI=http://localhost:8100/auth/callback
# Who may sign in: comma-separated Google emails. Required when
# AUTH_ENABLED=true. Anyone else is turned away, and removing an email ends
# that person's sessions. Restart the api after editing (docker compose up -d).
AUTH_ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
AUTH_IDENTITY_PROVIDER=Google
AUTH_RETURN_URL=/
# false only for local plain-http; refused in production.
AUTH_SECURE_COOKIES=false
# Show the Google profile photo. Turn on ONLY after ticking "Profile" under
# OpenID Connect scopes on the Cognito app client — otherwise every sign-in
# fails with invalid_scope.
AUTH_PROFILE_PICTURE=false

# ---- Vault: grocery sessions, phone numbers and OTPs sealed at rest (§14.3) ----
# Generate with:  npm --prefix server run vault:keygen
# The public key goes to api AND worker; the private key(s) to the worker ONLY.
# Rotation: new private key first, old one(s) after, comma-separated.
VAULT_PUBLIC_KEY=
VAULT_PRIVATE_KEYS=

# ---- Notifications (design §13.1) ----------------------------------------------
# Web Push keys, generated once:  npx --prefix server web-push generate-vapid-keys
# (paste them with printf, not an editor). The public key goes to api AND worker;
# the private key to the worker only. Empty = notifications are off.
# VAPID_SUBJECT is the contact push services can reach: mailto:you@... or https://...
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- The AI layer (design §7.8, §19) -----------------------------------------------------
# The model only reads households' words ("friends are staying next week") into
# facts they confirm; code does every calculation. LLM_PROVIDER runs each
# household's free monthly allowance on OUR key: openai (for users), anthropic
# (Claude, for our own testing) or off. A household can also paste its own
# OpenAI key in AI settings; that works whatever this says.
# Keys go to the worker only (paste with printf, not an editor). Models are
# optional: defaults gpt-4.1-mini and claude-opus-5 (server/src/constants.ts).
LLM_PROVIDER=off
# The off switch for every AI call on the site, households' own keys too
# (true by default). Set false and `docker compose up -d` if anything looks
# wrong; the forms keep working.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Home network (local only) -------------------------------------------------
# 0.0.0.0 opens the site to your Wi-Fi at http://<this computer's IP>:8100, but
# Google sign-in can't run there (Cognito allows http only for localhost). For a
# phone, use the dev tunnel instead (npm run tunnel). Leave empty on the VM.
WEB_BIND=

# ---- The browser, when a worker command is run from Windows (local only) -------
# Neither is needed in Docker: the worker image has Chromium at a known path and
# it prints its own version. They are for running a worker command against a real
# vendor from this machine, which is how the cart and payment paths are tested:
#
#   npx tsx --env-file=../.env src/worker/main.ts blinkit-dry-run <household-id>
#
# Windows Chrome prints nothing for --version, so the version has to be given.
# Read it from chrome://version, or from the folder name under Application\.
CHROME_PATH=
CHROME_VERSION=
